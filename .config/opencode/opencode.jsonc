{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "chrome-browser": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect",
        "--no-usage-statistics"
      ],
      "enabled": true
    }
  },
  "provider": {
    "confidence.house": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "confidence.house",
      "options": {
        "baseURL": "https://litellm.confidence.house/v1"
      },
      "models": {
        "pro": {
          "name": "pro",
          "limit": {
            "context": 262114,
            "output": 65536
          }
        },
        "mini": {
          "name": "mini",
          "limit": {
            "context": 1048576,
            "output": 384000
          },
          "variants": {
            "max": {
              "reasoningEffort": "max",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            },
            "high": {
              "reasoningEffort": "high",
              "textVerbosity": "low",
              "reasoningSummary": "auto"
            }
          }
        }
      }
    }
  },
  "plugin": [
    "opencode-see-image"
  ]
}

