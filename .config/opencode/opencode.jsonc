{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "permission": {
    "external_directory": {
      "~/tmp/**": "allow",
    },
  },
  "mcp": {
    "firefox": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@mozilla/firefox-devtools-mcp@latest",
        "--tool-preset developer",
      ],
      "enabled": false,
    },
    "chrome": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect",
        "--no-usage-statistics",
      ],
      "enabled": true,
    },
    "executor": {
      "type": "local",
      "command": [
        "executor",
        "mcp",
      ],
      "environment": {},
      "enabled": true,
    },
  },
  "provider": {
    "confidence.house": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "confidence.house",
      "options": {
        "baseURL": "https://litellm.confidence.house/v1",
      },
      "models": {
        "pro": {
          "name": "pro",
          "limit": {
            "context": 262114,
            "output": 65536,
          },
        },
        "mini": {
          "name": "mini",
          "limit": {
            "context": 262114,
            "output": 65536,
          },
        },
      },
    },
  },
  "plugin": [
    [
      "opencode-see-image@1.4.1",
      {
        "provider": "cloudflare-workers-ai",
        "model": "@cf/zai-org/glm-5.3-flash",
      },
    ],
  ],
}
