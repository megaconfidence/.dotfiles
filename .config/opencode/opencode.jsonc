{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/bin/zsh",
  "share": "disabled",
  "permission": {
    "external_directory": {
      "~/tmp/**": "allow",
    },
  },
  "mcp": {
    "firefox": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@mozilla/firefox-devtools-mcp@latest",
        "--tool-preset developer",
      ],
      "enabled": false,
    },
    "chrome": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "chrome-devtools-mcp@latest",
        "--autoConnect",
        "--no-usage-statistics",
      ],
      "enabled": true,
    },
    "executor": {
      "type": "local",
      "command": ["executor", "mcp"],
      "environment": {},
      "enabled": true,
    },
  },
  "provider": {
    "ltellm-anthropic": {
      "npm": "@ai-sdk/anthropic",
      "name": "litellm-anthropic",
      "options": {
        "baseURL": "{env:LITELLM_BASE_URL}/v1",
        "apiKey": "{env:LITELLM_API_KEY}",
      },
      "models": {
        "vertex_ai/claude-opus-5-5": {
          "name": "Claude Opus 5.5",
          "reasoning": true,
          "tool_call": true,
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
          "limit": {
            "context": 1000000,
            "output": 64000,
          },
        },
      },
    },
    "ltellm-openai": {
      "npm": "@ai-sdk/openai",
      "name": "litellm-openai",
      "options": {
        "baseURL": "{env:LITELLM_BASE_URL}",
        "apiKey": "{env:LITELLM_API_KEY}",
      },
      "models": {
        "azure_ai/gpt-6.1-sol": {
          "name": "GPT-6.1 Sol",
          "tool_call": true,
          "reasoning": true,
          "attachment": true,
          "modalities": {
            "input": ["text", "image", "pdf"],
            "output": ["text"],
          },
          "limit": {
            "context": 1050000,
            "input": 922000,
            "output": 128000,
          },
        },
      },
    },
    "confidence.house": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "confidence.house",
      "options": {
        "baseURL": "https://litellm.confidence.house/v1",
      },
      "models": {
        "pro": {
          "name": "pro",
          "limit": {
            "context": 262114,
            "output": 65536,
          },
        },
        "mini": {
          "name": "mini",
          "limit": {
            "context": 262114,
            "output": 65536,
          },
        },
      },
    },
  },
}
